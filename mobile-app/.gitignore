# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# The real env file (public values only, still never committed); the template
# `.env.example` stays tracked.
.env

# generated native folders
/ios
/android

# build output (EAS preview APK downloads)
/build/

# signing material and EAS local credentials — never committed
/credentials/
credentials.json

# verification evidence (screenshots of device runs; never committed)
/screenshots/
