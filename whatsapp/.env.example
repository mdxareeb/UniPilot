# ==========================================================
# WhatsApp service settings -- template, not loaded by the service.
#
# wa_service reads the process environment only (it never parses
# this file). These values are normally supplied by the worker
# host (locally the Node worker loads frontend/.env.development.local
# via --env-file), so set them there -- not in a file in this folder.
# The shared secrets (Supabase, UNIPILOT_INTEGRATIONS_KEY, the Google pair)
# are declared in ../frontend/.env.example (copy to .env.development.local
# locally or .env.local hosted); ../backend/.env.example documents only the
# WHATSAPP_* worker knobs.
# ==========================================================

# --- Supabase (service role) -------------------------------
# Commented: supplied by the worker environment.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# 32+ char pgcrypto key used by the encrypted QR / Google token RPCs.
# UNIPILOT_INTEGRATIONS_KEY=

# --- Google Calendar push (OPTIONAL) -----------------------
# Commented: supplied by the worker environment. The OAuth app is
# UniPilot-owned; users authorize per account. Without the pair the
# push job no-ops and the UI says "Not configured on this server".
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Which calendar to write to ("primary" = the user's default calendar)
GOOGLE_CALENDAR_ID=primary

# --- Live WhatsApp Web mode (self-host only) ---------------
# Seconds to wait for the QR scan (first run only); QR TTL is 60 s
LIVE_QR_TIMEOUT=180
# How many messages to scroll back and collect per chat
LIVE_MAX_MESSAGES=2000
# Seconds between scroll jumps (too fast = missed messages)
LIVE_SCROLL_WAIT=0.9
# How many patient "nothing new" rounds while WhatsApp fetches older
# history from the server. Each round waits twice as long as the last
# (0.9 -> 1.8 -> 3.6 -> ... capped 15s). 7 rounds = ~1.5-2 min patience.
LIVE_STALE_ROUNDS=7
# Root for per-user browser profiles (default: whatsapp/.profiles/<user_id>,
# created 0700 where the OS supports it). Dedicated host only.
WHATSAPP_PROFILE_ROOT=

# --- App settings ------------------------------------------
# Timezone used when events have no explicit timezone
# Examples: "Asia/Kolkata", "America/New_York", "Europe/London"
DEFAULT_TIMEZONE=Asia/Kolkata
# How to read numeric dates like 03/04/2026:
#   DMY = day first (3 April)  |  MDY = month first (March 4)
DATE_ORDER=DMY
# Default event duration in minutes when no end time is found
DEFAULT_EVENT_DURATION_MINUTES=60
# Sender names/numbers to IGNORE (comma separated)
IGNORE_SENDERS=

# --- Per-run hard caps -------------------------------------
# Parsed messages / new candidates per run (a capped run still succeeds)
WHATSAPP_MESSAGE_CAP=5000
WHATSAPP_CANDIDATE_CAP=500
