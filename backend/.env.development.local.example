# backend/ — local Supabase stack environment template. Copy to
# backend/.env.development.local while the local stack is running.
#
# Monorepo invariant: SUPABASE_URL here must equal
# frontend/.env.development.local's NEXT_PUBLIC_SUPABASE_URL — the same project
# seen from the backend (see README.md). Never put a secret in this variable.

SUPABASE_URL=http://127.0.0.1:54321

# Future server-only secrets — reserved, commented until a backend service
# actually needs them. Never expose any of these to the frontend or a browser.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
