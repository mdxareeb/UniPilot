# backend/ — hosted/default environment template. Copy to backend/.env.local.
# Never commit backend/.env.local (or any .env* file with real values).
#
# Monorepo invariant: SUPABASE_URL here must name the SAME Supabase project as
# frontend/.env.local's NEXT_PUBLIC_SUPABASE_URL (see README.md). It is the
# backend-side alias of that public URL — never a secret.

SUPABASE_URL=

# Future server-only secrets — reserved, commented until a backend service
# actually needs them. Never expose any of these to the frontend or a browser.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# WhatsApp worker-host settings (Task 46.x) — read by the Node worker
# (`npm run worker -w backend`) and passed to its Python child. The worker-host
# contract (Python >= 3.11 + the whatsapp/requirements*.txt groups) is in
# whatsapp/README.md. Local dev: the worker scripts load
# frontend/.env.development.local via --env-file, so set values there. On a
# deployed host, provide them through the platform secret store.
# Interpreter for `python -m wa_service` (default `python`; may be absolute).
# WHATSAPP_PYTHON=
# Live-mode browser-profile root (default whatsapp/.profiles/<user_id>):
# private volume, per-user 0700 dirs, purged on disconnect.
# WHATSAPP_PROFILE_ROOT=
# Optional export-sync timeout in seconds (default 300).
# WHATSAPP_SYNC_TIMEOUT=
