# backend/.env.example — the ONE backend environment template.
#
# Copy to `backend/.env` (git-ignored). The Node worker
# (`npm run worker -w backend`) and the backend scripts load it via
# `node --env-file=.env`. No `.env.local` / `.env.development.local` variant may
# exist.
#
# It is self-contained on purpose: the worker is a separate process and must not
# read the frontend file. Keep the shared Supabase/Presenton values in sync with
# `frontend/.env`.
#
# Monorepo invariant: SUPABASE_URL here must name the SAME Supabase project as
# frontend/.env's NEXT_PUBLIC_SUPABASE_URL (see README.md). It is the
# backend-side alias of that public URL — never a secret.
# Local default: http://127.0.0.1:54321; this host uses 127.0.0.1:54937 (WSL2
# port-forward workaround, QA_SESSION.md).

SUPABASE_URL=http://127.0.0.1:54321
# The worker reads the public pair directly too (storage uploads, auth checks).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The service role key bypasses RLS: never NEXT_PUBLIC_*, never
# committed, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# Task 31.x — the presentation generator's Presenton service (server-only). The
# worker starts and polls generations with these; the Next server keeps its own
# copy in frontend/.env. Runbook + exact API shapes:
# docs/integrations/presenton.md.
PRESENTON_URL=http://localhost:5001
PRESENTON_API_KEY=
# Browser-reachable origin for the embedded editor wrapper (defaults to
# PRESENTON_URL).
# PRESENTON_PUBLIC_URL=

# Task 20.10 / 20.9 — QA identity passwords, non-production only. Used by the
# QA seed (`npm run seed:qa`) and the Playwright specs (which read the frontend
# copy). Distinct from each other.
UNIPILOT_QA_PASSWORD=
UNIPILOT_QA2_PASSWORD=

# Task 46.x — WhatsApp worker-host settings, read by the Node worker and passed
# to its Python child. `wa_service` reads the process environment only; it never
# parses a .env file (whatsapp/README.md). The shared secrets (Supabase,
# UNIPILOT_INTEGRATIONS_KEY, the Google pair) are declared in frontend/.env;
# keep them in sync here too when the worker needs them.
# Interpreter for `python -m wa_service` (default `python`; may be absolute).
# WHATSAPP_PYTHON=
# Live-mode browser-profile root (default whatsapp/.profiles/<user_id>): private
# volume, per-user 0700 dirs, purged on disconnect.
# WHATSAPP_PROFILE_ROOT=
# Optional export-sync timeout in seconds (default 300).
# WHATSAPP_SYNC_TIMEOUT=
# Which calendar to write to ("primary" = the user's default calendar).
GOOGLE_CALENDAR_ID=primary
# Seconds to wait for the QR scan (first run only); QR TTL is 60 s.
LIVE_QR_TIMEOUT=180
# How many messages to scroll back and collect per chat.
LIVE_MAX_MESSAGES=2000
# Seconds between scroll jumps (too fast = missed messages).
LIVE_SCROLL_WAIT=0.9
# Patient "nothing new" rounds while WhatsApp fetches older history from the
# server; each waits twice as long as the last (capped 15 s). 7 ≈ 1.5–2 min.
LIVE_STALE_ROUNDS=7
# Timezone used when events have no explicit timezone (e.g. "Asia/Kolkata").
DEFAULT_TIMEZONE=Asia/Kolkata
# How to read numeric dates: DMY = day first (3 April), MDY = month first.
DATE_ORDER=DMY
# Default event duration in minutes when no end time is found.
DEFAULT_EVENT_DURATION_MINUTES=60
# Sender names/numbers to IGNORE (comma separated).
IGNORE_SENDERS=
# Per-run hard caps: parsed messages / new candidates (a capped run still
# succeeds).
WHATSAPP_MESSAGE_CAP=5000
WHATSAPP_CANDIDATE_CAP=500

# Future server-only secrets — reserved, commented until a backend service
# actually needs them. Never expose any of these to the frontend or a browser.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
