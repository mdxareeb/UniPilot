{
  "name": "@unipilot/backend",
  "private": true,
  "scripts": {
    "db:reset": "wsl -d kali-linux -u root -e supabase db reset",
    "db:lint": "wsl -d kali-linux -u root -e supabase db lint",
    "db:types": "wsl -d kali-linux -u root -e sh supabase/ops/generate-types.sh",
    "db:check-types": "wsl -d kali-linux -u root -e sh supabase/ops/check-types.sh",
    "seed:qa": "node --env-file=.env supabase/qa/seed-qa-identity.mjs",
    "worker": "node --env-file=.env worker/run.mjs",
    "worker:once": "node --env-file=.env worker/run.mjs --once",
    "benchmark": "node worker/benchmark.mjs",
    "search-benchmark": "node --env-file=.env worker/searchBenchmark.mjs",
    "test:whatsapp": "python -m pytest ../whatsapp",
    "test:groupsync": "node --test \"worker/groupsync/test/*.test.mjs\"",
    "test:groupsync:live": "node --env-file=.env --test worker/groupsync/test/repo.live.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
