# frontend/ â€” local Supabase development environment (auth email testing with
# Mailpit). Copy to frontend/.env.development.local.
# Next.js loads this file INSTEAD of .env.local during `npm run dev`
# (priority: .env.development.local > .env.local > .env.development > .env).
# Production builds keep using .env.local (hosted Supabase).
#
# Values below are the standard, public Supabase CLI local-dev defaults
# printed by `supabase start` â€” they are not secrets.
#
# Monorepo invariant: NEXT_PUBLIC_SUPABASE_URL here and
# backend/.env.development.local's SUPABASE_URL must name the SAME Supabase
# project (see README.md). A secret must never appear in a NEXT_PUBLIC_* var.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Task 14.11 â€” the app origin used for absolute Supabase redirect URLs
# (signup confirmation, password recovery, Google OAuth). Local development
# may omit it (a loopback host falls back to http://<host>); set it to mirror
# production. See lib/auth/origin.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Standard local Supabase service role key (public local default).
# Read by the QA seed and the Playwright specs only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Task 20.10 â€” QA identity password. Server-side only; never NEXT_PUBLIC_*,
# never committed with a real value. Used by backend/supabase/qa/seed-qa-identity.mjs
# and frontend/tests/qa/auth.setup.ts against the LOCAL stack only.
UNIPILOT_QA_PASSWORD=

# Task 20.9 â€” second QA identity (qa2.unipilot@unipilot.test) password, used by
# the two-user RLS isolation spec (frontend/tests/qa/rls-isolation.spec.ts).
# Distinct from QA1's; set any 8+ char local-only value.
UNIPILOT_QA2_PASSWORD=

# Task 3.13 â€” dev-only design specimen page (/specimen). Set to 1 to render
# the design-foundation specimen during local development. Never set in any
# other environment: without it the route serves 404, which is how the
# production build is kept free of specimen content.
UNIPILOT_SPECIMEN=

# Task 46.x â€” WhatsApp/Google integration secrets (server-only, never
# NEXT_PUBLIC_*). The worker inherits this same file via --env-file, so the
# Next server and the Python child read one copy.
# 32+ char pgcrypto key for the encrypted QR/token RPCs (required by the
# WhatsApp specs and the worker; rotate per backend/DATABASE.md).
UNIPILOT_INTEGRATIONS_KEY=
# Google OAuth pair for Calendar push. Unset is the honest local default: the
# integrations card says "Not configured on this server" and no push happens.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# "1" enables the live WhatsApp card; only on a single-tenant self-host worker
# with Chrome + whatsapp/requirements-live.txt. Leave unset for QA.
UNIPILOT_WHATSAPP_LIVE=

# Task 31.x â€” the presentation generator's Presenton service (server-only,
# never NEXT_PUBLIC_*; the worker inherits this file too). Unset is the honest
# local default: the tool page says generation isn't connected, the adapter
# refuses every call, and the worker settles such requests permanently with
# the same copy. To run it locally: start Presenton (port 5001), mint an admin
# API key, then set these. Runbook + exact API shapes:
# docs/integrations/presenton.md.
PRESENTON_URL=http://localhost:5001
PRESENTON_API_KEY=
# Browser-reachable origin for the embedded editor wrapper (defaults to
# PRESENTON_URL; set it when the worker resolves the service differently).
# PRESENTON_PUBLIC_URL=
# Task 31.x fork - the re-themed Presenton UI (see docs/superpowers/specs/
# 2026-09-15-presenton-fork-theme-design.md). When set AND reachable, the
# edit wrapper prefers it; unset or unreachable falls back to the engine's
# own editor above - never a dead link.
# PRESENTON_UI_URL=

# Future public keys â€” uncomment when introduced. Even here, never a secret:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
