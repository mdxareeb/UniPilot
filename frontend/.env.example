# frontend/.env.example — the ONE frontend environment template.
#
# Copy to `frontend/.env` (git-ignored). That is the only frontend env file:
# Next.js loads it, Playwright/`loadEnvFile` load it explicitly, and no
# `.env.local` / `.env.development.local` variant may exist — a stray variant
# would silently override this file (Next precedence).
#
# Local values are the public Supabase CLI defaults printed by `supabase start`
# (never secrets). On this host the local API runs at 127.0.0.1:54937 because of
# the WSL2 port-forward workaround (QA_SESSION.md); a default stack uses 54321.
#
# Monorepo invariant: NEXT_PUBLIC_SUPABASE_URL here and backend/.env's
# SUPABASE_URL must name the SAME Supabase project (see README.md).
# A secret must never appear in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Task 14.11 — the app's own public origin, used to build absolute Supabase
# redirect URLs (signup confirmation, password recovery, Google OAuth) without
# trusting the request Host header. Local dev may omit it (a loopback host falls
# back to http://<host>); set it to mirror production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (Next server + seed/test tooling). Standard local Supabase service
# role key — a public local default, but still never NEXT_PUBLIC_*, never
# committed with a real value.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Task 20.10 / 20.9 — QA identity passwords, non-production only (local Supabase
# stack). Used by the QA seed (backend) and the authenticated Playwright fixture.
# Distinct from each other; set any 8+ char local-only values. See QA_SESSION.md.
UNIPILOT_QA_PASSWORD=
UNIPILOT_QA2_PASSWORD=

# Optional Playwright fixture overrides, non-production only.
# QA_STORAGE_STATE: where the authenticated storage state is persisted
# (default frontend/.playwright/qa-session.json). QA_BASE_URL: app under test
# (default http://localhost:3000).
# QA_STORAGE_STATE=
# QA_BASE_URL=

# Task 3.13 — dev-only design specimen page (/specimen). Set to 1 to render the
# design-foundation specimen during local development; never set elsewhere (the
# route 404s without it, which keeps the production build free of it).
UNIPILOT_SPECIMEN=

# Task 26.1 — assistant provider (optional, server-only). Unset is the honest
# default: the assistant reports it is not configured and never invents a reply.
# ASSISTANT_PROVIDER=
# ASSISTANT_API_KEY=
# ASSISTANT_MODEL=

# Task 46.x — WhatsApp/Google integration secrets (server-only, never
# NEXT_PUBLIC_*). Used by the Next server for the OAuth callback and the live
# gate; the Python worker reads its own copy from backend/.env (keep the shared
# values in sync). Required for OAuth/push; unset is the honest local default.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32+ char pgcrypto key for the encrypted QR/token RPCs. Rotate with
# rotate_google_token_key(p_old, p_new) → swap env → restart Next + worker
# (runbook: backend/DATABASE.md). QR rows need no rotation (60 s TTL).
UNIPILOT_INTEGRATIONS_KEY=
# "1" enables the live WhatsApp card. Self-host only: single-tenant worker host
# with Chrome and whatsapp/requirements-live.txt. Unset everywhere else.
UNIPILOT_WHATSAPP_LIVE=

# Task 31.x — the presentation generator's Presenton service (server-only,
# never NEXT_PUBLIC_*). PRESENTON_URL unset is the honest default: the tool page
# says generation isn't connected and nothing is enqueued or faked.
# PRESENTON_API_KEY is the `sk-presenton-…` key minted in Presenton's admin
# (required when that instance has authentication enabled).
# PRESENTON_PUBLIC_URL is the browser-reachable origin for the embedded editor
# wrapper; it defaults to PRESENTON_URL. The worker keeps its own copy in
# backend/.env. Runbook + exact API shapes: docs/integrations/presenton.md.
PRESENTON_URL=
PRESENTON_API_KEY=
# PRESENTON_PUBLIC_URL=
# Optional server-only model declaration (never NEXT_PUBLIC_*).
# PRESENTON_MODEL is the model id this deployment's service is configured with
# (shown labelled as configured on the service when the engine's settings read
# is denied). PRESENTON_MODEL_OPTIONS is a comma-separated list of model ids the
# operator allows switching to; its presence is the opt-in for the model switch,
# which is deployment-global and only works when the engine grants its admin
# settings.
# PRESENTON_MODEL=
# PRESENTON_MODEL_OPTIONS=
# Task 31.x fork — the re-themed Presenton UI (see docs/superpowers/specs/
# 2026-09-15-presenton-fork-theme-design.md). When set AND reachable, the edit
# wrapper prefers it; unset or unreachable falls back to the engine's own editor
# — never a dead link.
# PRESENTON_UI_URL=

# Future public keys — uncomment when introduced. Even here, never a secret:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
