# frontend/ â€” hosted/default environment template. Copy to frontend/.env.local.
# Never commit .env.local. Only public credentials go in NEXT_PUBLIC_* variables.
#
# Monorepo invariant: NEXT_PUBLIC_SUPABASE_URL here and backend/.env.local's
# SUPABASE_URL must name the SAME Supabase project (see README.md). A secret
# must never appear in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Task 14.11 â€” the app's own public origin, used to build absolute Supabase
# redirect URLs (signup confirmation, password recovery, Google OAuth) without
# trusting the request Host header. Required outside local development; local
# dev may omit it (a loopback host falls back to http://<host>).
NEXT_PUBLIC_SITE_URL=

# Server-only. Never import in client components or middleware. Read only by
# test/seed tooling (the QA seed and the Playwright specs) â€” never by the app.
SUPABASE_SERVICE_ROLE_KEY=

# Task 20.10 â€” QA identity password, non-production only (local Supabase
# stack). Lives in frontend/.env.development.local; used by the QA seed and the
# authenticated Playwright fixture. See QA_SESSION.md.
UNIPILOT_QA_PASSWORD=

# Task 20.9 â€” second QA identity password, non-production only. Distinct from
# QA1's; used by the two-user RLS isolation spec. See QA_SESSION.md.
UNIPILOT_QA2_PASSWORD=

# Task 20.10 â€” optional Playwright fixture overrides, non-production only.
# QA_STORAGE_STATE: where the authenticated storage state is persisted
# (default frontend/.playwright/qa-session.json). QA_BASE_URL: app under test
# (default http://localhost:3000).
# QA_STORAGE_STATE=
# QA_BASE_URL=

# Future public keys â€” uncomment when introduced. Even here, never a secret:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Task 26.1 ï¿½ assistant provider (optional, server-only). Unset is the honest
# default: the assistant reports it is not configured and never invents a reply.
# ASSISTANT_PROVIDER=
# ASSISTANT_API_KEY=
# ASSISTANT_MODEL=

# Task 46.x â€” WhatsApp/Google integration secrets (server-only): the Next
# server uses them for the OAuth callback and the live gate, and the Python
# worker (spawned by the Node worker, inheriting its environment via
# --env-file) uses them for the encrypted QR RPCs and calendar push. Required
# by both the Next server and the Python worker for OAuth/push; never
# NEXT_PUBLIC_*, never committed, never logged.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32+ char pgcrypto key for the encrypted QR/token RPCs. Rotate with
# rotate_google_token_key(p_old, p_new) â†’ swap env â†’ restart Next + worker
# (runbook: backend/DATABASE.md). QR rows need no rotation (60 s TTL).
UNIPILOT_INTEGRATIONS_KEY=
# "1" enables the live WhatsApp card. Self-host only: single-tenant worker host
# with Chrome and whatsapp/requirements-live.txt. Unset everywhere else.
UNIPILOT_WHATSAPP_LIVE=

# Task 31.x â€” the presentation generator's Presenton service (server-only,
# never NEXT_PUBLIC_*). PRESENTON_URL unset is the honest default: the tool
# page says generation isn't connected and nothing is enqueued or faked.
# PRESENTON_API_KEY is the `sk-presenton-â€¦` key minted in Presenton's admin
# (required when that instance has authentication enabled).
# PRESENTON_PUBLIC_URL is the browser-reachable origin for the embedded editor
# wrapper; it defaults to PRESENTON_URL. Runbook + exact API shapes:
# docs/integrations/presenton.md.
PRESENTON_URL=
PRESENTON_API_KEY=
# PRESENTON_PUBLIC_URL=
# Task 31.x fork - the re-themed Presenton UI (see docs/superpowers/specs/
# 2026-09-15-presenton-fork-theme-design.md). When set AND reachable, the
# edit wrapper prefers it; unset or unreachable falls back to the engine's
# own editor above - never a dead link.
# PRESENTON_UI_URL=

