# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root, workspace and tooling installs)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (frontend workspace; unanchored so nested caches are covered)
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Templates only — placeholders and public local-Supabase defaults, no secrets.
!.env.example
!.env.development.local.example

# Task 20.10 — QA session artifacts. Storage-state files contain live session
# tokens; MCP browser output may contain QA screenshots. Never commit either.
.playwright/
.playwright-mcp/

# Verification screenshots (ad-hoc QA evidence; never committed)
/frontend/screenshots/

# Supabase CLI local state (config is machine/version-specific per backend/EMAIL.md;
# the CLI generates it — never hand-write it, never commit it).
backend/supabase/config.toml
backend/supabase/.temp/
backend/supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
