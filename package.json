{
  "name": "unipilot",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/start-env.mjs",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "test": "npm run test -w frontend",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:whatsapp": "npm run test:whatsapp -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:lint": "npm run db:lint -w backend",
    "db:types": "npm run db:types -w backend",
    "seed:qa": "npm run seed:qa -w backend",
    "worker": "npm run worker -w backend",
    "worker:once": "npm run worker:once -w backend"
  }
}
