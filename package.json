{
  "name": "unipilot",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "mobile-app",
    "whatsapp-bridge"
  ],
  "scripts": {
    "dev": "node scripts/start-env.mjs",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "test": "npm run test -w frontend",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:whatsapp": "npm run test:whatsapp -w backend",
    "test:groupsync": "npm run test:groupsync -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:lint": "npm run db:lint -w backend",
    "db:types": "npm run db:types -w backend",
    "seed:qa": "npm run seed:qa -w backend",
    "worker": "npm run worker -w backend",
    "worker:once": "npm run worker:once -w backend",
    "mobile:start": "npm run start -w mobile-app",
    "mobile:android": "npm run android -w mobile-app",
    "mobile:lint": "npm run lint -w mobile-app",
    "mobile:typecheck": "npm run typecheck -w mobile-app",
    "mobile:test": "npm run test -w mobile-app",
    "mobile:preview": "npm run build:preview -w mobile-app",
    "bridge": "npm run start -w whatsapp-bridge",
    "bridge:typecheck": "npm run typecheck -w whatsapp-bridge",
    "bridge:test": "npm run test -w whatsapp-bridge"
  }
}
